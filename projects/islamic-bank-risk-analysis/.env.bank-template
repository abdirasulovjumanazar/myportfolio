# ╔══════════════════════════════════════════════════════════════════════╗
# ║   ISLOMIY BANK RISK ANALYSIS — Bank Server Konfiguratsiyasi         ║
# ║   Bu fayl .env nomi bilan saqlanadi va server konfiguratsiyasini    ║
# ║   belgilaydi. Muhofaza qiling — uchinchi shaxslarga bermang!        ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ─── Ma'lumotlar bazasi ────────────────────────────────────────────────────
# PostgreSQL (tavsiya etiladi — production uchun)
DATABASE_URL=postgresql://ibra_user:STRONG_PASSWORD_HERE@localhost:5432/islamicbank_db

# SQLite (faqat test uchun):
# DATABASE_URL=sqlite:///./islamic_bank.db

# ─── Xavfsizlik ───────────────────────────────────────────────────────────
# JWT token uchun maxfiy kalit (kamida 32 belgi, tasodifiy yozing)
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_MINIMUM

# Token amal qilish muddati (daqiqa)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Muhit ────────────────────────────────────────────────────────────────
# Production rejimi: HTTPS va xavfsiz cookie yoqiladi
PRODUCTION=true

# ─── CORS (Qaysi domenlardan kirish ruxsat etiladi) ──────────────────────
# Bank ichki tarmog'i manzili:
ALLOWED_ORIGINS=http://192.168.1.100:8000,https://risk.yourbank.uz

# ─── Server ───────────────────────────────────────────────────────────────
# API ishlaydigan port
PORT=8000

# ─── QO'LLANMA ────────────────────────────────────────────────────────────
# 1. Bu faylni .env nomi bilan loyiha papkasiga saqlang
# 2. STRONG_PASSWORD_HERE o'rniga kuchli parol yozing
# 3. SECRET_KEY o'rniga: python -c "import secrets; print(secrets.token_hex(32))" buyrug'i natijasini qo'ying
# 4. docker-compose up -d --build buyrug'ini ishga tushiring
# 5. http://server-ip:8000/docs da Swagger UI oching
# 6. /api/v1/integration/admin/banks endpoint orqali bank yarating
# 7. /api/v1/integration/admin/api-keys endpoint orqali API kalit oling
# 8. 1C yoki boshqa tizimga API kalitni kiriting
