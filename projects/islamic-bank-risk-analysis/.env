# ─── Database Configuration ──────────────────────────────────────────
# For production PostgreSQL: postgresql://user:password@host:port/database
# For local development SQLite: sqlite:///./islamic_bank.db
DATABASE_URL=postgresql://postgres:jfa37777@localhost:5432/islamic_bank

# ─── Security (REQUIRED for production) ──────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real production key to version control!
SECRET_KEY=change-me-to-a-strong-random-secret-key-in-production

# Token lifetime in minutes (default: 1440 = 24 hours)
TOKEN_EXPIRE_MINUTES=1440

# ─── Environment Mode ─────────────────────────────────────────────────
# Set to "true" in production (enables HTTPS-only cookies, stricter CORS)
PRODUCTION=false

# ─── Allowed Origins (CORS) ───────────────────────────────────────────
# Comma-separated list for production, e.g.:
# ALLOWED_ORIGINS=https://yourbank.com,https://api.yourbank.com
# Bo'sh qoldirilsa barcha originlar qabul qilinadi (demo uchun qulay)
ALLOWED_ORIGINS=*

# ─── API Settings ─────────────────────────────────────────────────────
PORT=8000
DEBUG=True
